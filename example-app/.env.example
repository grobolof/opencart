# Хост приложения:
APP_HOST=opencart.docker.local

# Путь внутри контейнера, куда docker-compose монтирует корень репозитория (./:${APP_PATH})
APP_PATH=/pub/www/app

# Доступы для СУБД (все поля обязательны):
# DB_CONNECTION — драйвер. Допустимо: mysql, mariadb
DB_CONNECTION=mariadb
DB_HOST=database
# DB_PORT — порт СУБД (для MariaDB и MySQL — 3306)
DB_PORT=3306
DB_DATABASE=opencart
DB_USERNAME=login
DB_PASSWORD=pass

# Префикс таблиц OpenCart. Если не задан, используется oc_
OC_DB_PREFIX=oc_

# Язык установки. В релизе 4.1 есть en-gb и fr-fr — файл install/opencart-<язык>.sql
OC_LANGUAGE=en-gb

# Данные первой установки. Повторный запуск контейнера их не перезаписывает.
# Логин — от 3 до 20 символов, пароль — от 5 до 20 символов.
OC_ADMIN_USER=admin
OC_ADMIN_PASSWORD=password
OC_ADMIN_EMAIL=admin@example.com

# Если установить значение 1, то php cron.php будет выполняться раз в минуту
# Если установить значение 0, то системный крон не ставится
OC_CRON_ENABLED=0

# Если переменная MAILPIT_ENABLED задана, допустимы только значения 0 или 1
# Если значение 1, то mailpit будет перехватывать письма
# Если значение 0, то mailpit не будет перехватывать письма
# (контейнер mailpit обязательно нужен)
MAILPIT_ENABLED=0
MAILPIT_HOST=mailpit:1025
